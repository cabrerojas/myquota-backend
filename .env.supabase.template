# ===============================================
# myquota-backend — Supabase Environment Template
# Firestore → Supabase Migration, Phase 1
# ===============================================
# Copy this file to .env.supabase and fill in the values.
# NEVER commit .env.supabase to version control.

# ===============================================
# SUPABASE CONNECTION
# ===============================================
# Found in: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===============================================
# DATABASE (for direct Postgres connections if needed)
# ===============================================
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# ===============================================
# AUTHENTICATION
# ===============================================
# Keep existing JWT secrets for access/refresh tokens
# These are used by the app to sign its own JWTs
JWT_SECRET=your-jwt-secret-min-32-chars-here
JWT_REFRESH_SECRET=your-refresh-jwt-secret-min-32-chars-here

# ===============================================
# GOOGLE OAUTH
# ===============================================
# Keep existing Google OAuth credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
CREDENTIALS_JSON={"installed":{"client_id":"...","project_id":"...","auth_uri":"...","token_uri":"..."}}

# ===============================================
# SERVER
# ===============================================
NODE_ENV=production
PORT=3000

# ===============================================
# FEATURE FLAG
# Set to true to use Supabase repositories
# Set to false (or omit) to use Firestore
# ===============================================
USE_SUPABASE=true

# ===============================================
# ENCRYPTION (Phase 5 — AES-256 for Gmail tokens)
# Generate with: openssl rand -hex 32
# ===============================================
ENCRYPTION_KEY=your-64-char-hex-encryption-key-here