# .env.production.template
# Template for production environment variables on VPS.
# Copy to .env and fill in all values.
#
# ⚠️  ENCRYPTION_KEY must be generated and stored in your password manager.
#    NEVER commit this file or the .env file to git.
#
# Generate ENCRYPTION_KEY:
#   openssl rand -hex 32
#   (outputs 64 hex characters = 256 bits)

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Feature Flag ─────────────────────────────────────────────────────────────
# Set to 'true' to use Supabase. Set to 'false' to use Firestore.
USE_SUPABASE=true

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Encryption (AES-256) ──────────────────────────────────────────────────────
# REQUIRED when USE_SUPABASE=true
# Generate with: openssl rand -hex 32
# Store this key in your password manager — if lost, encrypted tokens are unrecoverable
ENCRYPTION_KEY=YOUR_64_CHAR_HEX_KEY_HERE

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Secrets for signing access and refresh tokens
# Generate with: openssl rand -hex 64
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# Token expiry
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Gmail API Credentials ────────────────────────────────────────────────────
# Base64-encoded JSON from Google Cloud Console → Credentials → OAuth client ID
# Encode with: base64 -w 0 credentials.json
# Or leave empty if Gmail import is not used
CREDENTIALS_JSON=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your frontend domain)
ALLOWED_ORIGINS=https://myquota.cl,https://www.myquota.cl